# Non-secret admin-stack inputs. Set each as a TF_VAR_* env var on the admin
# stack (e.g. TF_VAR_proxmox_node). Secrets never go here.

# Proxmox's Tailscale MagicDNS name (tailscale up on the PVE host first)
proxmox_endpoint = "https://pve.tailnet-name.ts.net:8006"

proxmox_node    = "pve"
omni_ct_id      = 200 # optional; default 200
omni_ct_ip      = "192.168.10.15/24"
omni_ct_gateway = "192.168.10.1"
omni_ct_vlan    = 10
omni_domain     = "omni.example.com"
k8s_vlan_cidr   = "10.0.101.0/24"
r2_account_id   = "cf-account-id-hex"
r2_bucket       = "omni-etcd-backups"
ssh_public_key  = "ssh-ed25519 AAAA... you@host"
