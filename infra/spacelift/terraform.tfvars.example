# Non-secret admin-stack inputs. Either commit a real terraform.tfvars-style
# file as *.auto.tfvars.example → filled by hand, or set these as TF_VAR_* on
# the admin stack. Secrets never go here.
# Proxmox's Tailscale MagicDNS name (tailscale up on the PVE host first)
proxmox_endpoint = "https://pve.tailnet-name.ts.net:8006"

shared_tfvars = {
  proxmox_node        = "pve"
  omni_ct_ip          = "192.168.10.15/24"
  omni_ct_gateway     = "192.168.10.1"
  ct_datastore        = "local-lvm"
  ct_template_file_id = "local:vztmpl/ubuntu-24.04-standard_24.04-2_amd64.tar.zst"
  ssh_public_key      = "ssh-ed25519 AAAA... you@host"
}
