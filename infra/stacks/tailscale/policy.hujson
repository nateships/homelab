// Tailnet policy file (HuJSON). This file is the source of truth; edit here,
// not in the admin console. The first apply replaces the console policy.
{
	// Who may apply each tag to devices.
	"tagOwners": {
		"tag:spacelift": ["autogroup:admin"],
		"tag:pve": ["autogroup:admin"],
		"tag:omni": ["autogroup:admin"],
		"tag:tsidp": ["autogroup:admin"],
	},

	// The PVE host is the subnet router for the k8s VLAN; approve its
	// advertisement automatically, no console click.
	"autoApprovers": {
		"routes": {
			"10.16.101.0/24": ["tag:pve"],
		},
	},

	"acls": [
		// Spacelift runs reach the Proxmox API and SSH (Ansible stack).
		// (Bare machine names are not valid in dst; the PVE host carries
		// tag:pve. Tagged devices also never hit key expiry.)
		{"action": "accept", "src": ["tag:spacelift"], "dst": ["tag:pve:8006", "tag:pve:22"]},

		// Default allow for everything else (Tailscale's default posture).
		// Tighten by replacing this rule with explicit ones.
		{"action": "accept", "src": ["*"], "dst": ["*:*"]},
	],

	// Tailscale SSH: the Ansible stack and tailnet members log into the
	// PVE host as root, authenticated by tailnet identity; no SSH keys.
	"ssh": [
		{"action": "accept", "src": ["tag:spacelift", "autogroup:member"], "dst": ["tag:pve"], "users": ["root"]},
	],

	// tsidp denies its admin UI and client registration by default; grant
	// them to tailnet members (that is: to you).
	"grants": [
		{
			"src": ["autogroup:member"],
			"dst": ["tag:tsidp"],
			"app": {
				"tailscale.com/cap/tsidp": [
					{
						"allow_admin_ui": true,
						"allow_dcr": true,

						// Omni rejects tokens without a verified email;
						// tailnet identities are verified by definition.
						"extraClaims": {
							"email_verified": true,
						},
						"includeInUserInfo": true,
					},
				],
			},
		},
	],
}
