// Tailnet policy (HuJSON). Edit here, not in the admin console.
{
	// Who may apply each tag to devices.
	"tagOwners": {
		"tag:spacelift": ["autogroup:admin"],
		"tag:pve": ["autogroup:admin"],
		"tag:omni": ["autogroup:admin"],
		"tag:tsidp": ["autogroup:admin"],
		// Talos nodes (siderolabs/tailscale system extension).
		"tag:talos": ["autogroup:admin"],
		// The Kubernetes operator; it provisions proxy devices as tag:k8s.
		"tag:k8s-operator": ["autogroup:admin"],
		"tag:k8s": ["tag:k8s-operator"],
	},

	// Auto-approve the PVE host's k8s VLAN route. The CIDR arrives as
	// TF_VAR_k8s_vlan_cidr through templatefile (main.tf).
	"autoApprovers": {
		"routes": {
			"${k8s_vlan_cidr}": ["tag:pve"],
		},
	},

	// tsidp serves its application endpoints publicly through Funnel
	// (TSIDP_USE_FUNNEL in omni/docker-compose.yml).
	"nodeAttrs": [
		{"target": ["tag:tsidp"], "attr": ["funnel"]},
	],

	"acls": [
		// Spacelift runs reach the Proxmox API and SSH.
		{"action": "accept", "src": ["tag:spacelift"], "dst": ["tag:pve:8006", "tag:pve:22"]},

		// Default allow for everything else (Tailscale's default posture).
		// Tighten by replacing this rule with explicit ones.
		{"action": "accept", "src": ["*"], "dst": ["*:*"]},
	],

	// Tailscale SSH: the Ansible stack and tailnet members log into
	// the PVE host as root. No SSH keys.
	"ssh": [
		{"action": "accept", "src": ["tag:spacelift", "autogroup:member"], "dst": ["tag:pve"], "users": ["root"]},
	],

	// Grant the tsidp admin UI and client registration to tailnet
	// members.
	"grants": [
		{
			"src": ["autogroup:member"],
			"dst": ["tag:tsidp"],
			"app": {
				"tailscale.com/cap/tsidp": [
					{
						"allow_admin_ui": true,
						"allow_dcr": true,

						// Omni rejects tokens without a verified email;
						// tailnet identities are verified by definition.
						"extraClaims": {
							"email_verified": true,
						},
						"includeInUserInfo": true,
					},
				],
			},
		},
	],
}
