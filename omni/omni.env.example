# ==============================================================================
# OMNI SELF-HOSTED CONFIGURATION (template; real values live in 1Password)
# ==============================================================================
# Render with the 1Password CLI so omni.env never exists unencrypted anywhere
# but the Omni LXC:
#   op inject -i omni.env.example -o omni.env
# Or copy this file to omni.env and fill in by hand. omni.env is gitignored.

# Generate with: uuidgen   (store in 1Password: op://homelab/omni/account-uuid)
OMNI_ACCOUNT_UUID={{ op://homelab/omni/account-uuid }}

NAME=omni

# Keep omnictl on the SAME release; mismatches fail with obscure gRPC errors.
# renovate: datasource=github-releases depName=siderolabs/omni
OMNI_IMG_TAG=v1.10.4

# ------------------------------------------------------------------------------
# Domain and network
# ------------------------------------------------------------------------------
# LXC's static IP (must match infra/stacks/omni omni_ct_ip), DNS A record on domain
OMNI_DOMAIN_NAME={{ op://homelab/omni/domain }}

BIND_ADDR=0.0.0.0:443
MACHINE_API_BIND_ADDR=0.0.0.0:8090
K8S_PROXY_BIND_ADDR=0.0.0.0:8100
EVENT_SINK_PORT=8091

ADVERTISED_API_URL=https://{{ op://homelab/omni/domain }}
ADVERTISED_K8S_PROXY_URL=https://{{ op://homelab/omni/domain }}:8100/
SIDEROLINK_ADVERTISED_API_URL=https://{{ op://homelab/omni/domain }}:8090/
# WireGuard: Omni LXC IP, reachable by Talos VMs (UDP)
SIDEROLINK_WIREGUARD_ADVERTISED_ADDR={{ op://homelab/omni/lxc-ip }}:50180

# ------------------------------------------------------------------------------
# TLS (Let's Encrypt via DNS challenge; see docs/BOOTSTRAP.md)
# ------------------------------------------------------------------------------
TLS_CERT=/etc/letsencrypt/live/{{ op://homelab/omni/domain }}/fullchain.pem
TLS_KEY=/etc/letsencrypt/live/{{ op://homelab/omni/domain }}/privkey.pem

# ------------------------------------------------------------------------------
# Storage + etcd encryption
# ------------------------------------------------------------------------------
ETCD_VOLUME_PATH=/etc/etcd
SQLITE_STORAGE_PATH=/etc/omni/sqlite/
# GPG key exported with: gpg --export-secret-key --armor
# Keep the key in 1Password too; without it etcd data is unrecoverable.
ETCD_ENCRYPTION_KEY=/etc/omni/omni.asc

# ------------------------------------------------------------------------------
# Auth: initial admin + ONE auth backend
# ------------------------------------------------------------------------------
INITIAL_USER_EMAILS={{ op://homelab/omni/admin-email }}

# Auth0 (SPA app; callback/logout/web-origin URLs = https://<domain>)
AUTH=--auth-auth0-enabled=true --auth-auth0-domain={{ op://homelab/omni/auth0-domain }} --auth-auth0-client-id={{ op://homelab/omni/auth0-client-id }}

# SAML alternative:
# AUTH=--auth-saml-enabled=true --auth-saml-url=https://your-idp/sso/saml
# OIDC alternative:
# AUTH=--auth-oidc-enabled=true --auth-oidc-issuer=https://your-idp --auth-oidc-client-id=...
