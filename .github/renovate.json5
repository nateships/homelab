{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "America/New_York",
  "labels": ["renovate"],
  "assignees": ["nateships"],
  // Automerge non-major once CI passes; majors stay manual via the rule below.
  "automerge": true,
  "platformAutomerge": true,
  "customManagers": [
    {
      // Agnostic annotation manager: track any pinned version that carries a
      //   # renovate: datasource=<ds> depName=<name> [versioning=<v>] [extractVersion=<re>]
      // comment on the line above it (env templates, cluster template, tf
      // defaults). Annotate a new pin and Renovate tracks it; no per-dependency
      // config needed.
      "customType": "regex",
      "managerFilePatterns": [
        "/^omni/.*\\.(ya?ml|example)$/",
        "/^infra/.*\\.tf$/",
        "/^scripts/.*\\.sh$/",
        "/^kubernetes/apps/.*\\.ya?ml$/",
        "/(^|/)Dockerfile(\\..+)?$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+)(?: registryUrl=(?<registryUrl>[^\\s]+))? depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?(?: extractVersion=(?<extractVersion>[^\\s]+))?\\s+.*?(?:=|:)\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "versioningTemplate": "semver-coerced"
    },
    {
      // op CLI pin in mise.toml. The mise manager cannot look this dep up
      // (no GitHub releases), so a dedicated regex tracks it via the
      // 1password/op Docker image tags. Anchored to the exact line because
      // the generic annotation regex would stop at the colon in "aqua:".
      "customType": "regex",
      "managerFilePatterns": ["/^mise\\.toml$/"],
      "matchStrings": ["\"aqua:1password/cli\"\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "1password/op",
      "datasourceTemplate": "docker"
    },
    {
      // ArgoCD install manifest URL in the bootstrap kustomization. Separate
      // manager because the version sits inside a URL, where the annotation
      // regex's `(?:=|:)` anchor would stop at "https:".
      "customType": "regex",
      "managerFilePatterns": ["/^kubernetes/bootstrap/argocd/kustomization\\.yaml$/"],
      "matchStrings": ["argoproj/argo-cd/(?<currentValue>v[\\d.]+)/manifests/install\\.yaml"],
      "depNameTemplate": "argoproj/argo-cd",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Silence the mise manager's doomed lookup for the op CLI (no GitHub releases). The 1password/op regex manager owns this pin.",
      "matchDepNames": ["1password/cli"],
      "enabled": false
    },
    {
      "description": "op CLI pins (mise.toml + runner Dockerfile) move together",
      "matchDepNames": ["1password/op"],
      "groupName": "op-cli"
    },
    {
      "description": "Major updates: manual review, never automerge",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major-update"]
    },
    // Coupled pins move together, one PR each: server/CLI mismatches break
    // omnictl (gRPC errors) and violate kubectl version skew.
    {
      "description": "Omni server + omnictl",
      "matchDepNames": ["siderolabs/omni", "omnictl"],
      "groupName": "omni"
    },
    {
      "description": "Talos + talosctl",
      "matchDepNames": ["siderolabs/talos", "talosctl"],
      "groupName": "talos"
    },
    {
      "description": "Kubernetes + kubectl",
      "matchDepNames": ["kubernetes/kubernetes", "kubectl"],
      "groupName": "kubernetes"
    },
    {
      "description": "Cilium: ArgoCD app + bootstrap render script move together. CI fails the PR until scripts/render-cilium-bootstrap.sh is re-run.",
      "matchDepNames": ["cilium"],
      "groupName": "cilium"
    }
  ]
}
