{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "America/New_York",
  "labels": ["renovate"],
  "assignees": ["nateships"],
  // Automerge non-major once CI passes; majors stay manual via the rule below.
  "automerge": true,
  "platformAutomerge": true,
  // Off by default in Renovate; tracks `rev:` pins in .pre-commit-config.yaml.
  "pre-commit": { "enabled": true },
  "customManagers": [
    {
      // Tracks any pin that carries a
      //   # renovate: datasource=<ds> depName=<name> [versioning=<v>] [extractVersion=<re>]
      // comment on the line above it.
      "customType": "regex",
      "managerFilePatterns": [
        "/^omni/.*\\.(ya?ml|example)$/",
        "/^infra/.*\\.tf$/",
        "/^scripts/.*\\.sh$/",
        "/^kubernetes/apps/.*\\.ya?ml$/",
        "/(^|/)Dockerfile(\\..+)?$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+)(?: registryUrl=(?<registryUrl>[^\\s]+))? depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?(?: extractVersion=(?<extractVersion>[^\\s]+))?\\s+.*?(?:=|:)\\s*\"?(?<currentValue>[^\"\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\"?"
      ],
      "versioningTemplate": "semver-coerced"
    },
    {
      // op CLI pin in mise.toml, tracked via the 1password/op Docker
      // image tags (the CLI has no GitHub releases).
      "customType": "regex",
      "managerFilePatterns": ["/^mise\\.toml$/"],
      "matchStrings": ["\"aqua:1password/cli\"\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "1password/op",
      "datasourceTemplate": "docker"
    },
    {
      // ArgoCD install manifest URL in the bootstrap kustomization; the
      // version sits inside a URL.
      "customType": "regex",
      "managerFilePatterns": ["/^kubernetes/bootstrap/argocd/kustomization\\.yaml$/"],
      "matchStrings": ["argoproj/argo-cd/(?<currentValue>v[\\d.]+)/manifests/install\\.yaml"],
      "depNameTemplate": "argoproj/argo-cd",
      "datasourceTemplate": "github-releases"
    },
    {
      // Gateway API CRD manifest URL in the cilium kustomization; the
      // version sits inside a URL.
      "customType": "regex",
      "managerFilePatterns": ["/^kubernetes/apps/cilium/kustomization\\.yaml$/"],
      "matchStrings": ["gateway-api/releases/download/(?<currentValue>v[\\d.]+)/standard-install\\.yaml"],
      "depNameTemplate": "kubernetes-sigs/gateway-api",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "The op CLI has no GitHub releases; the 1password/op regex manager owns this pin.",
      "matchDepNames": ["aqua:1password/cli", "1password/cli"],
      "enabled": false
    },
    {
      "description": "pinDigests off: the kustomize helmCharts field cannot carry a digest.",
      "matchManagers": ["kustomize"],
      "pinDigests": false
    },
    {
      "description": "pinDigests off: the Docker datasource is only a version feed for a mise version string.",
      "matchDepNames": ["1password/op"],
      "groupName": "op-cli",
      "pinDigests": false
    },
    {
      "description": "Major updates: manual review, never automerge",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major-update"]
    },
    // Coupled pins move together, one PR each.
    {
      "description": "Omni server + omnictl",
      "matchDepNames": ["siderolabs/omni", "omnictl"],
      "groupName": "omni"
    },
    {
      "description": "Talos + talosctl",
      "matchDepNames": ["siderolabs/talos", "talosctl"],
      "groupName": "talos"
    },
    {
      "description": "Kubernetes + kubectl",
      "matchDepNames": ["kubernetes/kubernetes", "kubectl"],
      "groupName": "kubernetes"
    },
    {
      "description": "Cilium: ArgoCD app + the helm_template pin in infra/stacks/cluster move together.",
      "matchDepNames": ["cilium"],
      "groupName": "cilium"
    }
  ]
}
